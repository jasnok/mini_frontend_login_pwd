# Docker PostgreSQL (pgvector) 환경 설정
# 로컬 호스트에서 docker-compose.yml의 pgvector PostgreSQL에 접속하기 위한 설정

# PostgreSQL 연결 설정
DB_HOST=localhost           # 로컬 호스트에서 접속
DB_PORT=5433               # Docker 포트 매핑: 호스트 5433 → 컨테이너 5432
DB_USER=agent_user         # PostgreSQL 사용자
DB_PASSWORD=agent_pwd      # PostgreSQL 비밀번호
DB_NAME=agent_db           # PostgreSQL 데이터베이스

# Gemini API 설정 (채팅 서비스용)
GOOGLE_API_KEY=your_google_api_key_here

# 개발 환경 설정
DEBUG=false
