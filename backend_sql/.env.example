# Docker PostgreSQL (pgvector) 환경 설정 예제
# 이 파일을 .env로 복사하고 적절한 값으로 수정하여 사용하세요

# PostgreSQL 연결 설정
DB_HOST=localhost           # Docker host
DB_PORT=5433               # Docker PostgreSQL 외부 포트
DB_USER=agent_user         # PostgreSQL 사용자
DB_PASSWORD=agent_pwd      # PostgreSQL 비밀번호
DB_NAME=agent_db           # PostgreSQL 데이터베이스

# Gemini API 설정 (채팅 서비스용)
GOOGLE_API_KEY=your_google_api_key_here

# 개발 환경 설정
DEBUG=false
